# ── Supabase (frontend) ────────────────────────────────────────────────────────
# Project Settings → API → Project URL y anon public key
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (backend / Vercel Edge Functions) ─────────────────────────────────
# Settings → API → service_role — NUNCA exponer al frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Token generado en @BotFather — solo lo usa el backend
TELEGRAM_BOT_TOKEN=1234567890:AAFkj-_x9Y2hLqWzpQmnVtKxBpRsTuVwXyz

# URL pública donde Telegram enviará los updates
# Registrar con: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<WEBHOOK_URL>"
TELEGRAM_WEBHOOK_URL=https://tu-dominio.vercel.app/api/telegram
