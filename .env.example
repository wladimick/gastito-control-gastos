# ── Frontend Vite ──────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# La clave publicable se expone al navegador y debe estar protegida por Auth + RLS.
# NUNCA uses SUPABASE_SERVICE_ROLE_KEY con el prefijo VITE_.

# ── Supabase Edge Function: telegram-webhook ──────────────────────────────────
# Configurar normalmente con `supabase secrets set`, no en el frontend.
TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=reemplazar-por-un-secreto-aleatorio

# Para desarrollo local de Edge Functions solamente.
# En Supabase desplegado, SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY están
# disponibles automáticamente dentro de la función.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Referencia útil para registrar el webhook; la función no necesita leerla.
TELEGRAM_WEBHOOK_URL=https://xxxxxxxxxxxx.supabase.co/functions/v1/telegram-webhook
