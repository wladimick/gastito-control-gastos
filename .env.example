# ── Supabase ──────────────────────────────────────────────────────────────────
# Crea un proyecto en https://supabase.com y copia los valores desde
# Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Telegram Bot ───────────────────────────────────────────────────────────────
# Token generado en @BotFather  (solo lo necesita el backend/webhook)
# En el frontend se guarda en TelegramSettings por el usuario.
TELEGRAM_BOT_TOKEN=1234567890:AAFkj-_x9Y2hLqWzpQmnVtKxBpRsTuVwXyz

# URL pública donde Telegram enviará los updates (tu dominio Vercel)
# Ejemplo: https://gastito.vercel.app/api/telegram
TELEGRAM_WEBHOOK_URL=https://tu-dominio.vercel.app/api/telegram
